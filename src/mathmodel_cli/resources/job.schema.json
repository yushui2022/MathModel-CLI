{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MathModel CLI Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "edition", "inputs", "engine", "delivery", "runtime"],
  "properties": {
    "schema_version": {"const": "1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\u0000-\u001f]+$"},
    "edition": {"const": "standard"},
    "inputs": {"type": "string", "minLength": 1, "maxLength": 500},
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "model", "effort", "base_url", "api_key_env"],
      "properties": {
        "name": {"const": "codex"},
        "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,159}$"},
        "effort": {"enum": ["low", "medium", "high", "xhigh"]},
        "base_url": {"type": "string", "maxLength": 500},
        "api_key_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}_API_KEY$"}
      }
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "target_pages", "instructions"],
      "properties": {
        "language": {"enum": ["zh-CN", "en"]},
        "target_pages": {"type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "integer", "minimum": 1, "maximum": 100}},
        "instructions": {"type": "string", "maxLength": 8000}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["cpus", "memory_mb", "pids_limit", "attempt_timeout_seconds", "max_attempts"],
      "properties": {
        "cpus": {"type": "integer", "minimum": 1, "maximum": 32},
        "memory_mb": {"type": "integer", "minimum": 1024, "maximum": 65536},
        "pids_limit": {"type": "integer", "minimum": 64, "maximum": 1024},
        "attempt_timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    }
  }
}
